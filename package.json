{
    "name": "whatsapp-bot",
    "version": "1.0.0",
    "description": "Bot de WhatsApp con comandos tipo terminal via Evolution API",
    "main": "src/core/server.js",
    "scripts": {
        "start": "node src/core/server.js",
        "dev": "nodemon src/core/server.js",
        "test": "node --test test/*.test.js",
        "typecheck": "tsc --noEmit -p tsconfig.v2.json",
        "lint": "eslint src/v2 scripts/v2 tests/unit/v2 tests/unit/tooling tests/contract",
        "architecture": "node scripts/v2/check-architecture.cjs",
        "env:generate": "node scripts/v2/env-example.cjs --write",
        "env:check": "node scripts/v2/env-example.cjs",
        "test:v2": "node --test tests/unit/v2/*.test.js tests/unit/tooling/*.test.js tests/contract/*.test.js",
        "coverage:v2": "node scripts/v2/check-coverage.cjs",
        "verify": "npm run typecheck && npm run lint && npm run architecture && npm run env:check && npm run coverage:v2",
        "test:contract": "node --test tests/contract/*.test.js",
        "verify:phase2": "npm run verify && node scripts/v2/check-phase2.cjs"
    },
    "dependencies": {
        "axios": "^1.7.2",
        "dotenv": "^16.6.1",
        "express": "^4.19.2",
        "form-data": "^4.0.0",
        "googleapis": "^176.0.0",
        "minecraft-server-util": "^5.4.4",
        "node-webpmux": "^3.2.1",
        "sqlite3": "^6.0.1"
    },
    "devDependencies": {
        "@types/node": "20.19.43",
        "eslint": "10.12.0",
        "nodemon": "^3.1.4",
        "typescript": "5.9.3"
    },
    "engines": {
        "node": ">=20.19.0"
    }
}
