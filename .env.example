# ─────────────────────────────────────────────────────────────
#  Botsky - Plantilla de Variables de Entorno (.env.example)
#  Copia este archivo a .env y rellena con tus credenciales.
# ─────────────────────────────────────────────────────────────

TZ=America/Mexico_City

# ── Evolution API (WhatsApp Webhook & Messaging) ─────────────
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=tu_clave_de_evolution_api_aqui
EVOLUTION_INSTANCE=Botsky

# ── Configuración del Servidor Webhook ───────────────────────
WEBHOOK_PORT=3000
WEBHOOK_HOST=0.0.0.0
WEBHOOK_URL=https://tu-dominio.com/webhook

# ── Control de Acceso y Autorizaciones ───────────────────────
# Listas separadas por comas (JIDs o números sin @s.whatsapp.net)
ALLOWED_GROUPS_NORMAL=
ALLOWED_NUMBERS_NORMAL=
ALLOWED_GROUPS_ADMIN=
ALLOWED_NUMBERS_ADMIN=521XXXXXXXXXX

# ── Almacenamiento y Rutas Temporales ────────────────────────
TMP_DIR=/tmp/whatsapp-bot
DATA_DIR=./data

# Optional refactor v1 telemetry: sidecar DB, no text or user identifiers.
LEGACY_COMMAND_USAGE_ENABLED=false
LEGACY_COMMAND_USAGE_DB=./data/command-usage.db
MAX_FILE_SIZE_MB=100
MAX_DOCUMENT_SIZE_MB=50
MAX_QUEUE_PER_USER=3

# ── Transcripción (Whisper) ──────────────────────────────────
WHISPER_MODEL=small
WHISPER_LANGUAGE=es

# ── Descargas Multimedia (yt-dlp) ───────────────────────────
YTDLP_DEFAULT_QUALITY=720
YTDLP_DEFAULT_AUDIO_QUALITY=192
YOUTUBE_COOKIES_FILE=./data/youtube_cookies.txt

# ── Spotify API ──────────────────────────────────────────────
SPOTIFY_CLIENT_ID=tu_spotify_client_id
SPOTIFY_CLIENT_SECRET=tu_spotify_client_secret

# ── Google Drive API ─────────────────────────────────────────
DRIVE_FOLDER_ID=tu_google_drive_folder_id
# Llave maestra de 32 bytes para encriptación de token OAuth2
MASTER_KEY=genera_una_llave_hex_de_32_bytes_aqui

# ── Inteligencia Artificial (Groq) ───────────────────────────
GROQ_API_KEY=gsk_tu_clave_groq_aqui
GROQ_MODEL=qwen/qwen3.8-27b
GROUP_CONTEXT_MESSAGES=10

# ── Servidor Minecraft Bedrock ──────────────────────────────
MINECRAFT_HOST=127.0.0.1
MINECRAFT_PORT=19132
DOCKER_HOST=mc-bedrock

# ── Arquitectura del Bot ─────────────────────────────────────
USE_TOOL_REGISTRY=true
BACKUPS=/home/petrov/backups

# ─────────────────────────────────────────────
#  Google Gemini AI
# ─────────────────────────────────────────────
GEMINI_API_KEY=tu_clave_gemini_1_aqui
GEMINI_API_KEY_2=tu_clave_gemini_2_aqui
GEMINI_API_KEY_3=tu_clave_gemini_3_aqui
GEMINI_MODEL=gemini-3.5-flash-lite
