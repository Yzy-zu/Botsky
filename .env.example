# Botsky environment schema (generated; no credentials)
# Empty optional values use schema defaults. Set integration credentials before activation.
# Dynamic GEMINI_API_KEY_N (positive integer N): CSV keys, secret, numeric order.
# Infrastructure HOME/PATH/USER/SHELL/NODE_ENV/NODE_OPTIONS/PM2_HOME is managed by the runtime.

# Zona IANA para horarios y calendarios. (public; timezone)
TZ=America/Mexico_City

# URL HTTP(S) de Evolution. (public; url)
EVOLUTION_API_URL=http://localhost:8080

# Credencial de Evolution; requerida al conectar. (secret; string)
EVOLUTION_API_KEY=

# Nombre de instancia Evolution. (public; string)
EVOLUTION_INSTANCE=Botsky

# Puerto de escucha webhook. (public; integer)
WEBHOOK_PORT=3000

# Interfaz configurable del servidor webhook. (public; string)
WEBHOOK_HOST=0.0.0.0

# URL pública webhook; plantilla legacy, opcional. (public; url)
WEBHOOK_URL=

# Secreto del header webhook v2; configurar antes de activar verificación. (secret; string)
WEBHOOK_SECRET=

# Límite body; conserva 50 MB legacy hasta revisión operacional. (public; number)
WEBHOOK_BODY_LIMIT_MB=50

# Allowlist de JIDs/números separados por coma; comparar igualdad normalizada. (secret; list)
ALLOWED_GROUPS_NORMAL=

# Allowlist de JIDs/números separados por coma; comparar igualdad normalizada. (secret; list)
ALLOWED_NUMBERS_NORMAL=

# Allowlist de JIDs/números separados por coma; comparar igualdad normalizada. (secret; list)
ALLOWED_GROUPS_ADMIN=

# Allowlist de JIDs/números separados por coma; comparar igualdad normalizada. (secret; list)
ALLOWED_NUMBERS_ADMIN=

# Allowlist de JIDs/números separados por coma; comparar igualdad normalizada. (secret; list)
ALLOWED_NUMBERS_TASKS=

# Número propio para normalizar identidad; sin teléfono hardcodeado. (secret; string)
BOT_NUMBER=

# Alias LID propio verificado para reconocer menciones y citas; nunca inferido del teléfono. (secret; string)
BOT_LID=

# Directorio temporal multimedia. (public; string)
TMP_DIR=/tmp/whatsapp-bot

# Directorio durable de datos. (public; string)
DATA_DIR=./data

# Biblioteca local packs/cooperacha; sustituye ruta de usuario legacy. (public; string)
FOTOS_DIR=./data/fotos

# Biblioteca local rikolino; configurar antes de portar feature. (public; string)
RIKOLINO_DIR=./data/rikolino

# Scripts de TV; sustituye directorio del usuario legacy. (public; string)
TV_SCRIPT_DIR=./scripts/tv

# Directorio respaldos; variable de plantilla legacy. (public; string)
BACKUPS=./backups

# Sidecar SQLite telemetría separado del negocio. (public; string)
LEGACY_COMMAND_USAGE_DB=./data/command-usage.db

# Cookies yt-dlp; archivo opcional. (public; string)
YOUTUBE_COOKIES_FILE=

# Directorio remoto Minecraft; configurar al activar adapter. (public; string)
MINECRAFT_BASE_PATH=./data/minecraft

# Checkout operacional elegido explícitamente por operador. (public; string)
BOTSKY_PRODUCTION_DIR=.

# Imagen para runner aislado; operador puede fijar digest. (public; string)
BOTSKY_BASELINE_IMAGE=node:20-bookworm

# Salida runner baseline aislado. (public; string)
BOTSKY_BASELINE_OUTPUT=/tmp/botsky-v2-baseline.tap

# Imagen de pruebas legacy con herramientas y fixtures aislados. (public; string; operator-only)
BOTSKY_LEGACY_VERIFICATION_IMAGE=botsky/legacy-verification:node20

# Salida TAP del entorno legacy reproducible. (public; string; operator-only)
BOTSKY_LEGACY_VERIFICATION_OUTPUT=/tmp/botsky-legacy-verification.tap

# Archivo productor Rikolino para preparar fixture externo; proporcionar ruta al construir la imagen. (public; string; operator-only)
BOTSKY_LEGACY_LIBRARY_SOURCE=

# Alias legacy de cookies; prevalece YOUTUBE_COOKIES_FILE. (public; string; alias of YOUTUBE_COOKIES_FILE)
COOKIES_FILE=

# Telemetría v1 opcional; sin inicialización si está apagada. (public; boolean)
LEGACY_COMMAND_USAGE_ENABLED=false

# Límite envío/descarga medios; default real legacy 64, plantilla anterior 100. (public; number)
MAX_FILE_SIZE_MB=64

# Límite documento; legacy aplica piso 200 aunque plantilla indicaba 50. (public; number)
MAX_DOCUMENT_SIZE_MB=200

# Límite salida yt-dlp. (public; number)
WHATSAPP_MAX_MEDIA_MB=50

# Alias legacy de WHATSAPP_MAX_MEDIA_MB. (public; number; alias of WHATSAPP_MAX_MEDIA_MB)
WHATSAPP_MAX_MB=50

# Límite compartido fallback por usuario. (public; integer)
MAX_QUEUE_PER_USER=3

# Límite cola light; fallback a MAX_QUEUE_PER_USER si explícito. (public; integer)
MAX_QUEUE_LIGHT=5

# Límite cola heavy; fallback a MAX_QUEUE_PER_USER si explícito. (public; integer)
MAX_QUEUE_HEAVY=3

# Llamadas IA simultáneas. (public; integer)
MAX_AI_CONCURRENCY=3

# Umbral aviso memoria RSS. (public; integer)
RAM_WARN_MB=700

# Umbral crítico memoria RSS. (public; integer)
RAM_CRIT_MB=900

# Ventana de contexto; variable de plantilla legacy. (public; integer)
GROUP_CONTEXT_MESSAGES=10

# Timeout estándar Gemini; overrides por tarea en adapter. (public; integer)
GEMINI_TIMEOUT_MS=12000

# Timeout remoto Minecraft en ms. (public; integer)
MINECRAFT_CMD_TIMEOUT=15000

# Tope envelopes de captura Fase 0. (public; integer)
REFRACTOR_CAPTURE_LIMIT=50

# Duración máxima captura Fase 0 en ms. (public; integer)
REFRACTOR_CAPTURE_DURATION=900000

# Espera coalescer en ms; 0 desactiva debounce. (public; integer)
MESSAGE_DEBOUNCE_MS=1200

# Modelo Whisper; variable de plantilla legacy. (public; string)
WHISPER_MODEL=small

# Idioma Whisper; default real legacy auto, plantilla anterior es. (public; string)
WHISPER_LANGUAGE=auto

# Dispositivo faster-whisper del script Python (p. ej. cpu/cuda). (public; string)
WHISPER_DEVICE=cpu

# Precisión faster-whisper del script Python. (public; string)
WHISPER_COMPUTE_TYPE=int8

# Altura video; default real legacy 480, plantilla anterior 720. (public; integer)
YTDLP_DEFAULT_QUALITY=480

# Bitrate audio kbps. (public; integer)
YTDLP_DEFAULT_AUDIO_QUALITY=192

# Cliente Spotify; variable de plantilla legacy. (secret; string)
SPOTIFY_CLIENT_ID=

# Secreto Spotify; variable de plantilla legacy. (secret; string)
SPOTIFY_CLIENT_SECRET=

# Carpeta destino Drive; requerido por su feature. (secret; string)
DRIVE_FOLDER_ID=

# Clave hexadecimal de 32 bytes para tokens OAuth2. (secret; hex32)
MASTER_KEY=

# Credencial ElevenLabs opcional. (secret; string)
ELEVENLABS_API_KEY=

# Claves Gemini separadas por coma; orden principal, numeradas, lista múltiple. (secret; list)
GEMINI_API_KEY=

# Claves Gemini separadas por coma; orden principal, numeradas, lista múltiple. (secret; list)
GEMINI_API_KEY_2=

# Claves Gemini separadas por coma; orden principal, numeradas, lista múltiple. (secret; list)
GEMINI_API_KEY_3=

# Claves Gemini separadas por coma; orden principal, numeradas, lista múltiple. (secret; list)
GEMINI_API_KEYS=

# Modelo Gemini configurable; no valida disponibilidad externa. (public; string)
GEMINI_MODEL=gemini-3.5-flash-lite

# Credencial Groq opcional. (secret; string)
GROQ_API_KEY=

# Modelo Groq chat; legacy Whisper tiene override propio. (public; string)
GROQ_MODEL=openai/gpt-oss-20b

# Destino SSH Minecraft; requerido al conectar, sin host personal default. (public; string)
MINECRAFT_SSH_HOST=

# Contenedor remoto Bedrock. (public; string)
MINECRAFT_CONTAINER=mc-bedrock

# Host Bedrock; variable de plantilla legacy. (public; string)
MINECRAFT_HOST=127.0.0.1

# Puerto Bedrock; variable de plantilla legacy. (public; integer)
MINECRAFT_PORT=19132

# Endpoint Docker; no asumir que nombre contenedor es endpoint. (public; string)
DOCKER_HOST=

# Variable muerta legacy conservada en inventario; pendiente DROP del cliente. (public; boolean; legacy-only)
USE_TOOL_REGISTRY=true

# Captura operacional sanitizada; ortografía legacy REFRACTOR preservada. (public; boolean)
REFRACTOR_CAPTURE_ENABLED=false

# Destino captura operacional temporal. (public; string)
REFRACTOR_CAPTURE_DIR=

# JID propio para clasificar cita del bot durante captura. (secret; string)
REFRACTOR_CAPTURE_BOT_JID=

# Identidades alternativas propias durante captura. (secret; list)
REFRACTOR_CAPTURE_BOT_ALIASES=

# Deduplicación de envelopes capturados. (public; boolean)
REFRACTOR_CAPTURE_DEDUPE=false

# Dueño del pipeline; sombra nunca ejecuta efectos. (public; enum)
PIPELINE_MODE=legacy

# Archivo exclusivo por ejecución para diffs de sombra sin datos personales. (public; string; operator-only)
BOTSKY_SHADOW_OUTPUT=

# Relajar selección de sesión solo por configuración aprobada. (public; boolean)
SESSION_GROUP_RELAXED=false

# Terminal v2 desactivable; revisar cambio de producto antes de activar. (public; boolean)
FEATURE_ADMIN_TERMINAL=false

# Preparación flag v2; disponibilidad final requiere decisión de producto. (public; boolean)
FEATURE_ADULT_MEDIA=false

# Kill-switch global; además requiere opt-in por chat. (public; boolean)
PROACTIVE_ENABLED=false

# Seguimiento privado proactivo desactivado por defecto. (public; boolean)
PROACTIVE_PRIVATE_REVENGE=false

# Cuota diaria proactividad por chat. (public; integer)
PROACTIVE_MAX_PER_DAY=3

# Separación mínima proactividad 45 minutos. (public; integer)
PROACTIVE_MIN_INTERVAL_MS=2700000

# Inicio silencio diario HH:mm. (public; string)
PROACTIVE_QUIET_START=23:00

# Fin silencio diario HH:mm. (public; string)
PROACTIVE_QUIET_END=08:00

# Presupuesto chat privado. (public; integer)
RESPONSE_PRIVATE_MAX_CHARS=600

# Presupuesto chat grupal. (public; integer)
RESPONSE_GROUP_MAX_CHARS=350

# Tokens salida chat. (public; integer)
LLM_CHAT_MAX_OUTPUT_TOKENS=300

# Tokens salida routing. (public; integer)
LLM_ROUTE_MAX_OUTPUT_TOKENS=120

# Tokens salida agent. (public; integer)
LLM_AGENT_MAX_OUTPUT_TOKENS=600

# Tokens salida lectura/vision. (public; integer)
LLM_VISION_MAX_OUTPUT_TOKENS=1500
